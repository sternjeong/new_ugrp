  },
  "v1-09": {
   "group": "T",
   "text": "perovskite solar cells and optoelectronic devices",
   "H": 0.941,
   "V": 0.912
  },
  "v1-10": {
   "group": "T",
   "text": "핵융합 플라즈마 진단 연구",
   "H": 0.765,
   "V": 0.898
  },
  "v1-11": {
   "group": "T",
   "text": "climate change and extreme weather events",
   "H": 0.898,
   "V": 0.834
  },
  "v1-12": {
   "group": "T",
   "text": "미세먼지 같은 대기오염 연구",
   "H": 0.661,
   "V": 0.949
  },
  "m1": {
   "group": "M",
   "text": "로봇은 싫고 생체 신호 분석이 좋아요",
   "H": 0.355,
   "V": 0.499
  },
  "m2": {
   "group": "M",
   "text": "반도체 소자보다 의료 로봇이 좋아요",
   "H": 0.764,
   "V": 0.383
  },
  "m3": {
   "group": "M",
   "text": "배터리 소재의 수명과 열화를 연구하고 싶어요",
   "H": 0.773,
   "V": 0.953
  },
  "m4": {
   "group": "M",
   "text": "양자컴퓨터 연구를 하고 싶어요",
   "H": 0.954,
   "V": 0.822
  },
  "m5": {
   "group": "M",
   "text": "의료 영상에서 종양을 찾고 싶어요",
   "H": 0.639,
   "V": 0.519
  },
  "m6": {
   "group": "M",
   "text": "컴퓨터 구조가 재밌어요",
   "H": 0.612,
   "V": 0.423
  },
  "m7": {
   "group": "M",
   "text": "화학은 별로고 신약 개발이 궁금해요",
   "H": 0.719,
   "V": 0.468
  },
  "m8": {
   "group": "M",
   "text": "기후 변화와 탄소 포집 연구",
   "H": 0.9,
   "V": 0.792
  },
  "m9": {
   "group": "M",
   "text": "고분자 합성 연구를 하고 싶어요",
   "H": 0.503,
   "V": 0.532
  },
  "m10": {
   "group": "M",
   "text": "전자회로는 싫고 뇌과학이 좋아요",
   "H": 0.975,
   "V": 0.473
  },
  "b1": {
   "group": "B",
   "text": "딥러닝 영상 처리",
   "H": 0.476,
   "V": 0.899
  },
  "b2": {
   "group": "B",
   "text": "배터리 전해질 소재",
   "H": 0.818,
   "V": 0.717
  },
  "b3": {
   "group": "B",
   "text": "반도체 공정 학부연구생",
   "H": 0.644,
   "V": 0.74
  },
  "b4": {
   "group": "B",
   "text": "단백질 구조 분석",
   "H": 0.77,
   "V": 0.72
  },
  "b5": {
   "group": "B",
   "text": "로봇 제어 기계",
   "H": 0.911,
   "V": 0.844
  },
  "b6": {
   "group": "B",
   "text": "수학과인데 데이터 분석이나 최적화 쪽 연구실 들어가고 싶어요.",
   "H": 0.59,
   "V": 0.824
  },
  "b7": {
   "group": "B",
   "text": "원자력 안전이나 방사선 쪽 연구하는 곳 있나요?",
   "H": 0.629,
   "V": 0.916
  },
  "b8": {
   "group": "B",
   "text": "물리학과 2학년인데 양자 컴퓨팅 같은 거 해볼 수 있는 연구실 찾고 있어요.",
   "H": 0.797,
   "V": 0.756
  },
  "b9": {
   "group": "B",
   "text": "미세먼지나 수처리 같은 환경 문제 다루는 연구실이 궁금해요.",
   "H": 0.414,
   "V": 0.817
  },
  "b10": {
   "group": "B",
   "text": "공급망이나 생산 일정 최적화 같은 거 하는 산업경영 연구실 추천해주세요.",
   "H": 0.389,
   "V": 0.795
  },
  "b11": {
   "group": "B",
   "text": "코딩은 좋아하는데 하루 종일 실험실에서 시약 만지는 건 별로예요. 계산이나 시뮬레이션 위주 연구실 있을까요?",
   "H": 0.767,
   "V": 0.622
  },
  "b12": {
   "group": "B",
   "text": "회로 설계는 재밌는데 납땜이나 장비 다루는 건 싫어요. 이론이나 시뮬레이션 쪽 전자전기 연구실 찾아요.",
   "H": 0.463,
   "V": 0.39
  },
  "b13": {
   "group": "B",
   "text": "세포 키우고 하는 건 좋은데 동물실험은 피하고 싶어요. 생명과학이나 의공학 쪽 어디가 맞을까요?",
   "H": 0.897,
   "V": 0.609
  },
  "b14": {
   "group": "B",
   "text": "신소재 열역학 수업이 재밌었는데 이런 걸 연구에 쓰는 연구실 있나요?",
   "H": 0.483,
   "V": 0.791
  },
  "b15": {
   "group": "B",
   "text": "알고리즘이랑 운영체제 수업 재밌게 들었어요. 시스템 쪽 연구실 추천해주세요.",
   "H": 0.627,
   "V": 0.849
  },
  "b16": {
   "group": "B",
   "text": "유기화학 수업 듣고 합성에 관심 생겼는데 화학과나 화공 쪽에서 비슷한 연구 하는 데 있어요?",
   "H": 0.796,
   "V": 0.641
  },
  "b17": {
   "group": "B",
   "text": "인공지능에 관심이 많은데 아직 뭘 전공으로 할지 확실하지 않아요. 논문 읽고 세미나 하는 분위기보다는 직접 모델 돌려보고 프로젝트 하는 곳이 좋아요. 다음 학기부터 6개월 정도 학부연구생 하고 싶어요.",
   "H": 0.338,
   "V": 0.81
  },
  "b18": {
   "group": "B",
   "text": "기계공학과 3학년이고 드론이나 자율주행처럼 움직이는 걸 만드는 데 관심 있어요. 주 2~3회 정도 나가서 하드웨어 만들고 테스트하는 연구실이면 좋겠어요. 방학 동안 집중해서 참여하고 대학원 진학도 고민 중이에요.",
   "H": 0.622,
   "V": 0.524
  },
  "b19": {
   "group": "B",
   "text": "Looking for a lab doing computer vision or generative AI where undergrads can join as research interns.",
   "H": 0.657,
   "V": 0.497
  },
  "b20": {
   "group": "B",
   "text": "I'm a chemistry major interested in solar cells or catalysts. Any labs open to undergraduate researchers?",
   "H": 0.704,
   "V": 0.697
  }
 }
